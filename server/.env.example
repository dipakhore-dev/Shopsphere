# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/shopsphere?retryWrites=true&w=majority

# ---- CORS / links in emails ----
# Comma-separated list of frontend origins. The FIRST one is used for links in emails.
CLIENT_URL=http://localhost:5173

# ---- Authentication ----
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (short-lived on purpose)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token / session lifetime in days
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (12 is a good production default)
BCRYPT_ROUNDS=12

# ---- Cookies ----
# lax    -> frontend and API share a site (dev, or Vercel rewrite proxy in production)
# none   -> frontend and API are on different sites (requires secure cookies / HTTPS)
COOKIE_SAME_SITE=lax
# Leave empty to default to true in production and false otherwise
COOKIE_SECURE=

# ---- Email (Nodemailer) ----
# DEVELOPMENT: leave SMTP_HOST empty. Emails are then only SIMULATED: nothing is sent and the
#   verification link is printed in the server terminal.
# PRODUCTION: SMTP_HOST, SMTP_USER and SMTP_PASS are REQUIRED (the server refuses to start without them).
#
# Gmail setup (free): turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  and paste it below (spaces are ignored).
#   Your normal Gmail password will NOT work.
#   - port 587 + SMTP_SECURE=false  -> STARTTLS (recommended)
#   - port 465 + SMTP_SECURE=true   -> TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# With Gmail the sender must be your own Gmail address, otherwise Gmail rewrites it.
EMAIL_FROM="ShopSphere <your_email@gmail.com>"
# Verification links stop working after this many minutes
EMAIL_VERIFICATION_TTL_MINUTES=30
# Minimum wait before another verification email can be requested
EMAIL_RESEND_COOLDOWN_SECONDS=60

# ---- Image uploads (Cloudinary) ----
# Free account at https://cloudinary.com -> Dashboard -> "API Keys".
# Without these, sellers cannot upload product images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- One-time admin provisioning (used ONLY by `npm run seed:admin`) ----
# Remove ADMIN_PASSWORD from this file after the admin has been created.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base URL of the API.
#
# Development: leave as /api. Vite proxies /api -> http://localhost:5000
# (see vite.config.js), so the browser sees one origin and cookies "just work".
#
# Production (Vercel): set to your Render URL, e.g.
#   VITE_API_URL=https://shopsphere-api.onrender.com/api
VITE_API_URL=/api

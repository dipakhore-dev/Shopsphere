{
  "info": {
    "name": "ShopSphere API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run '0. Get CSRF token' first. Phase 2: auth. Phase 3: products (prices are in paise)."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Attach the CSRF token (saved by 'Get CSRF token') to every request.",
          "const t = pm.collectionVariables.get('csrf');",
          "if (t) { pm.request.headers.upsert({ key: 'X-CSRF-Token', value: t }); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "emailToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "images",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Get CSRF token  (run this FIRST)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/csrf",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "csrf"
          ]
        },
        "description": "Sets the csrfToken cookie and saves the same value in the {{csrf}} variable. Postman stores cookies automatically."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('csrf', pm.response.json().data.csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Verma\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"Passw0rd!x\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Check the SERVER CONSOLE for the verification email (printed when SMTP is not configured). Copy the token from the link into the {{emailToken}} variable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('role is customer', () => pm.expect(pm.response.json().data.user.role).to.eql('customer'));",
              "pm.test('no token in body', () => pm.expect(pm.response.json().data.accessToken).to.be.undefined);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"Passw0rd!x\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('auth cookies set', () => { pm.expect(pm.cookies.has('accessToken') || true).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Me (current user)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 when logged in', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Refresh session",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "description": "Rotates the refresh token. Sending the OLD token again later revokes the whole session family."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Verify email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/verify-email",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "verify-email"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{emailToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. Resend verification (login first)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/resend-verification",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "resend-verification"
          ]
        }
      }
    },
    {
      "name": "8. Forgot password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "forgot-password"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Always returns 200. The reset link is printed in the server console; copy its token into {{emailToken}}."
      }
    },
    {
      "name": "9. Reset password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{emailToken}}\",\n  \"password\": \"NewPassw0rd!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Phase 3 - Products",
      "description": "MONEY IS IN PAISE: 499900 means Rs 4,999. Log in as the demo seller (npm run seed:demo prints the password) before the seller requests.",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json().data.categories; if (c.length) pm.collectionVariables.set('categoryId', c[0].id);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List products (filters + sort)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?category=electronics&minPrice=100000&maxPrice=500000&minRating=3&inStock=true&sort=price_asc&page=1&limit=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "electronics"
                },
                {
                  "key": "minPrice",
                  "value": "100000"
                },
                {
                  "key": "maxPrice",
                  "value": "500000"
                },
                {
                  "key": "minRating",
                  "value": "3"
                },
                {
                  "key": "inStock",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "12"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.data.products.length) pm.collectionVariables.set('productId', j.data.products[0].id);",
                  "pm.test('has pagination meta', () => pm.expect(j.meta.totalPages).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by keyword",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?q=earbuds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "earbuds"
                }
              ]
            }
          }
        },
        {
          "name": "Suggestions (search as you type)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/suggestions?q=wir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "suggestions"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "wir"
                }
              ]
            }
          }
        },
        {
          "name": "Product details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Seller login (demo seller)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.seller@shopsphere.test\",\n  \"password\": \"<password printed by seed:demo>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Seller: my products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sellers/products?status=all&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "products"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "all"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Seller: upload images (pick files in Body)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sellers/products/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "products",
                "images"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "Needs CLOUDINARY_* in server/.env. Select 1-6 JPEG/PNG/WebP files (max 5 MB each). The response is saved into {{images}} for the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('images', JSON.stringify(j.data.images));"
                ]
              }
            }
          ]
        },
        {
          "name": "Seller: create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Earbuds Pro\",\n  \"description\": \"Noise cancelling earbuds with a 28 hour battery.\",\n  \"category\": \"{{categoryId}}\",\n  \"brand\": \"Auralis\",\n  \"price\": 499900,\n  \"discountPrice\": 399900,\n  \"stock\": 25,\n  \"tags\": [\"earbuds\", \"bluetooth\"],\n  \"specifications\": [{ \"key\": \"Warranty\", \"value\": \"1 year\" }],\n  \"images\": {{images}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); pm.test('201', () => pm.response.to.have.status(201)); if (j.success) pm.collectionVariables.set('productId', j.data.product.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Seller: update product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 549900,\n  \"discountPrice\": null,\n  \"stock\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Seller: delete product (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}